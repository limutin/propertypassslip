rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Pass Slips Collection
    match /passSlips/{passSlipId} {
      // Anyone can create a pass slip (public form submission)
      allow create: if true;
      
      // Only authenticated users (admins) can read and update
      allow read, update: if request.auth != null;
      
      // No one can delete pass slips
      allow delete: if false;
    }
    
    // Settings Collection
    match /settings/{document=**} {
      // Anyone can read settings (for authorized signatures, etc.)
      allow read: if true;
      
      // Only authenticated users (admins) can write
      allow write: if request.auth != null;
    }
    
    // Admins Collection (optional)
    match /admins/{adminId} {
      // Only authenticated users can read/write
      allow read, write: if request.auth != null;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
